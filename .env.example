# ==========================================================
# Gagan Engineering Works — Environment Variables Configuration
# ==========================================================

# 1. RESEND EMAIL API (Required for Contact Lead Notifications)
# -----------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender address:
# - Default test sender (only delivers to your verified Resend account email): onboarding@resend.dev
# - Production sender (after verifying your custom domain in Resend): inquiries@gaganengineerings.in
SENDER_EMAIL=onboarding@resend.dev

# Recipient address (where customer inquiries will be forwarded):
BUSINESS_EMAIL=gaganengineerings@gmail.com


# 2. ADMIN CREDENTIALS (for /admin panel)
# -----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=gaganworks2006


# 3. MONGODB DATABASE (Optional - for persistent lead storage & dynamic catalogue)
# -----------------------------------------------------------------
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/gagan_engineering?retryWrites=true&w=majority
DB_NAME=gagan_engineering


# 4. CANONICAL WEBSITE URL
# -----------------------------------------------------------------
WEBSITE_URL=https://www.gaganengineerings.in
