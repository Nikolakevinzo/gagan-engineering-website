{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "installCommand": "npm install --legacy-peer-deps",
        "buildCommand": "npm run build"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gagan-engineering-website.vercel.app"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gagan-engineering-website-six.vercel.app"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/$1"
      }
    },
    {
      "src": "/product/?",
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/products"
      }
    },
    {
      "src": "/gallery/?",
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/factory"
      }
    },
    {
      "src": "/returns/?",
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/return-policy"
      }
    },
    {
      "src": "/category/([^/]+)/?",
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/products/category/$1"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "api/index.py",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600, s-maxage=86400"
      }
    },
    {
      "src": "/google-merchant-feed.xml",
      "dest": "api/index.py",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600, s-maxage=86400"
      }
    },
    {
      "src": "/google-shopping-feed.xml",
      "dest": "api/index.py",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600, s-maxage=86400"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/static/$1"
    },
    {
      "src": "/(.*\\.(?:png|jpg|jpeg|svg|ico|json|txt|xml|woff|woff2|ttf|eot))",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|yandexbot|duckduckbot|slurp|baiduspider|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|gptbot|chatgpt-user|perplexitybot|google-extended|claudebot|anthropic-ai|oai-searchbot|applebot|semrushbot|ahrefsbot|petalbot).*"
        }
      ],
      "dest": "/api/index.py?__seo_path=$1"
    },
    {
      "src": "/(?:|products(?:/category/[^/]+|/[^/]+)?|category/[^/]+|blog(?:/[^/]+)?|about|factory|contact|return-policy|privacy-policy|terms|product|gallery|returns|admin(?:/.*)?)/?",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    }
  ]
}
