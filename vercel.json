{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "installCommand": "npm install --legacy-peer-deps",
        "buildCommand": "npm run build"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gagan-engineering-website.vercel.app"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gagan-engineering-website-six.vercel.app"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.gaganengineerings.in/$1"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "api/index.py",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600, s-maxage=86400"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/static/$1"
    },
    {
      "src": "/(.*\\.(?:png|jpg|jpeg|svg|ico|json|txt|xml|woff|woff2|ttf|eot))",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
